# Copy to .env and fill in. The .env file is git-ignored.

# Port the API listens on
PORT=5000

# JWT signing secret. REQUIRED in production (>= 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long tokens stay valid (default 7d)
# JWT_EXPIRES_IN=7d

# Admin (ranger) tokens expire sooner — default 2h. Override with any
# jsonwebtoken duration string, e.g. 30m, 12h.
# JWT_ADMIN_EXPIRES_IN=2h

# Comma-separated list of origins allowed to call the API in browsers
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 when running behind a reverse proxy / load balancer so rate
# limiting and IP checks see the real client address.
# TRUST_PROXY=1

# Override the SQLite database location (tests/CI use this for throwaway DBs).
# DATABASE_PATH=/absolute/path/to/database.sqlite

# Login rate limiter tuning — defaults are the production values
# (5 failed attempts per 15 minutes per client IP + email pair).
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Per-IP request budgets (defaults: 300 per 15 min for the API, 20 per 15 min
# for /api/auth). Raise only when a legitimate deployment needs it.
# API_RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# Per-admin write budgets for privileged operations (role changes, deletions,
# status changes). Default 0 = use the per-route defaults (10-60 per 15 min).
# ADMIN_RATE_LIMIT_MAX=0

# Retention window (in days) for the server-side security_events log. The log
# records failed logins and rejected tokens, so it grows continuously; a
# rolling window bounds its size. Set to 0 to disable pruning.
# SECURITY_EVENTS_RETENTION_DAYS=90

# Development-only convenience: returning password-reset tokens in responses
# and logs so the reset flow can be tested without email infrastructure.
# Never enable in production (production ignores this and always withholds
# the token).
# DEV_EXPOSE_RESET_TOKEN=1

# NODE_ENV=production refuses to boot without a strong JWT_SECRET.
# NODE_ENV=production
