# Dependencies
node_modules/

# Lockfiles are committed so CI can install reproducibly with `npm ci` and
# audit the exact dependency tree. (No longer ignored.)

# Database
*.sqlite
*.sqlite3
*.db
*.sqlite.*

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build output
dist/
build/
.cache/

# Uploads
server/uploads/*
!server/uploads/.gitkeep

# Temporary files
*.tmp
*.temp

# Credentials / tokens (never commit)
# These files may contain live JWTs, API keys, or secrets.
*.token.txt
token.txt
admin_token.txt
normal_token.txt
old_admin_token.txt
test_token.txt

# Explicit safety net for server environment
server/.env
server/.env.local
server/.env.*.local
