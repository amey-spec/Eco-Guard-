{
  "name": "ecoguard",
  "version": "1.0.0",
  "description": "Environmental Safety & Hazard Awareness Platform",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "audit:deps": "node scripts/dependency-audit.js client && node scripts/dependency-audit.js server"
  },
  "keywords": ["environment", "safety", "hazard", "awareness"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
